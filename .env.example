# Copia este archivo a .env y llena los valores reales.
# .env está en .gitignore — nunca se commitea.

# Servidor
PORT=3000

# Base de datos (Postgres)
DATABASE_URL=postgres://usuario:password@localhost:5432/kilo

# Transcripción de voz — Groq (Whisper Large v3 Turbo)
GROQ_API_KEY=

# Extracción de campos — Anthropic (Claude Haiku)
ANTHROPIC_API_KEY=

# Cobros — Culqi (tarjeta y Yape)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Notificaciones push — Firebase Cloud Messaging
FCM_SERVICE_ACCOUNT_JSON=
