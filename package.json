{
	"name": "smartbite-api",
	"version": "0.0.1",
	"description": "Backend SmartBite — Tecsup 2026-1",
	"author": "JosepRivera",
	"private": true,
	"scripts": {
		"start:dev": "nest start --watch",
		"build": "nest build",
		"lint": "biome check --write ./src ./test",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:baseline": "prisma migrate resolve --applied 20260409000000_supabase_auth",
		"db:generate": "prisma generate",
		"db:seed": "tsx prisma/seed.ts",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status",
		"test": "vitest run --project unit",
		"test:e2e": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from app-test --remove-orphans && docker compose -f docker-compose.test.yml down -v",
		"dev": "docker compose up",
		"stop": "docker compose down",
		"dev:clean": "docker compose down -v"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.17",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^11.1.18",
		"@nestjs/platform-express": "^11.1.18",
		"@nestjs/schedule": "^6.1.1",
		"@nestjs/swagger": "^11.2.6",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@supabase/supabase-js": "^2.103.0",
		"dotenv": "^17.4.1",
		"groq-sdk": "^1.1.2",
		"helmet": "^8.1.0",
		"jose": "^6.2.2",
		"nestjs-zod": "^5.3.0",
		"node-sql-parser": "^5.3.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@nestjs/cli": "^11.0.18",
		"@nestjs/schematics": "^11.0.10",
		"@nestjs/testing": "^11.1.18",
		"@tsconfig/node24": "^24.0.4",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.1.0",
		"@types/node": "^24.12.2",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.3",
		"prisma": "^7.7.0",
		"supertest": "^7.2.2",
		"ts-loader": "^9.5.7",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.3"
	}
}
